# Supabase Public Config (Client-Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER & CI ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 / S3-Compatible Storage Config
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=edtech-videos-prod
CLOUDFLARE_R2_PUBLIC_URL=https://videos.yourdomain.com

# Admin Dashboard Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET_SESSION_TOKEN=your-session-secret

# Mobile App Supabase Config (Flutter)
# Passed via --dart-define or assets/config.json
FLUTTER_SUPABASE_URL=https://your-project.supabase.co
FLUTTER_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
